{
  "name": "myriadflow-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MyriadFlow \u2014 the Vibe Manufacturing launchpad. Site for myriadflow.com.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm build && pnpm check:html && pnpm check:anchors && pnpm check:links",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "linkinator dist --recurse --config linkinator.config.json",
    "check:anchors": "node scripts/check-anchors.mjs dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyriadFlow/website.git"
  },
  "homepage": "https://myriadflow.com",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "html-validate": "^11.22.1",
    "linkinator": "^8.1.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
